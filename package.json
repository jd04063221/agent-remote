{
  "name": "agent-remote-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Distributed multi-agent remote-brain / local-execution control plane (Go + TypeScript)",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "clean": "pnpm -r --if-present clean",
    "go:test": "cd apps/remote-node && go test -race ./...",
    "go:build": "cd apps/remote-node && go build -o bin/agent-remote-node ./cmd/agent-remote-node"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
