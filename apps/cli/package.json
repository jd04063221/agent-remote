{
  "name": "agent-remote",
  "version": "0.1.3",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agent-remote": "./dist/index.js",
    "ar": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agent-remote/protocol": "workspace:*",
    "@agent-remote/core": "workspace:*",
    "@agent-remote/tool-plane": "workspace:*",
    "@agent-remote/transport": "workspace:*",
    "@agent-remote/acp-server": "workspace:*",
    "@agent-remote/hub-server": "workspace:*"
  }
}
