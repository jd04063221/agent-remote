{
  "name": "@agent-remote/desktop",
  "version": "0.1.4",
  "description": "agent-remote multi-agent remote-brain / local-execution desktop workbench",
  "author": "agent-remote <noreply@users.noreply.github.com>",
  "homepage": "https://github.com/jd04063221/agent-remote",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "start": "electron ./dist/main.js",
    "dist:mac": "electron-builder --config electron-builder.yml --mac",
    "dist:win": "electron-builder --config electron-builder.yml --win",
    "dist:linux": "electron-builder --config electron-builder.yml --linux",
    "clean": "rm -rf dist release"
  },
  "dependencies": {
    "@agent-remote/hub-server": "workspace:*",
    "agent-remote": "workspace:*"
  },
  "peerDependencies": {
    "electron": ">=35.0.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  }
}
